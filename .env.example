# Supabase project connection. Copy this file to .env.local and fill in
# values for the dedicated sumg-garment-lab Supabase project. The app must
# still run with these unset; features that need Supabase should report
# themselves as unavailable, not fail silently or fake data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app, used to build the email confirmation link
# sent by Supabase Auth on sign-up (see app/signup/actions.ts). Required
# for account confirmation to work; leave unset in environments where
# sign-up isn't being exercised.
NEXT_PUBLIC_SITE_URL=
